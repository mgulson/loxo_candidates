<p class="muted"><%= @candidate.role %> · <%= @candidate.name %></p>
<h1>Your scorecard</h1>
<p class="muted">Your feedback will be saved under your selected user. You can submit one scorecard for this candidate.</p>
<section class="panel">
  <% if @scorecard.errors.any? %><div class="flash alert"><%= @scorecard.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @scorecard, url: candidate_scorecard_path(candidate_name: @candidate.name), method: :post do |form| %>
    <% %i[technical_skill communication collaboration role_fit].each do |field| %>
      <%= form.label field, field.to_s.humanize, class: "field" %>
      <%= form.text_field field %>
    <% end %>
    <%= form.label :notes, "Notes", class: "field" %>
    <%= form.text_area :notes %>
    <p><%= form.submit "Submit scorecard", class: "button" %> <%= link_to "Cancel", candidate_path(name: @candidate.name), class: "button secondary" %></p>
  <% end %>
</section>
