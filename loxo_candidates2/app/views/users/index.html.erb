<p class="muted">Hiring workspace</p>
<h1>Welcome, <%= current_user.name %>.</h1>
<p class="muted">Review your open assignments and candidates you manage.</p>
<p><%= link_to "All candidates", candidates_path, class: "button secondary" %> <%= link_to "Add candidate", new_candidate_path, class: "button" %></p>

<h2>Candidates you manage</h2>
<% if @managed_candidates.empty? %>
  <p class="muted">You are not the hiring manager for any candidates yet.</p>
<% else %>
  <div class="grid">
    <% @managed_candidates.each do |candidate| %>
      <article class="candidate-card">
        <h3><%= link_to candidate.name, candidate_path(name: candidate.name) %></h3>
        <p class="muted"><%= candidate.role %></p>
      </article>
    <% end %>
  </div>
<% end %>

<h2>Candidates assigned to you</h2>
<% if @assigned_candidates.empty? %>
  <p class="muted">You have no candidate assignments yet.</p>
<% else %>
  <div class="grid">
    <% @assigned_candidates.each do |candidate| %>
      <article class="candidate-card">
        <h3><%= link_to candidate.name, candidate_path(name: candidate.name) %></h3>
        <p class="muted"><%= candidate.role %> · Hiring manager: <%= candidate.hiring_manager %></p>
      </article>
    <% end %>
  </div>
<% end %>
