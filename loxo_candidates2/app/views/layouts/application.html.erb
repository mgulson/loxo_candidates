<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Loxo Candidates</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #17231f; background: #f4f6f3; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      header { display: flex; justify-content: space-between; align-items: center; padding: 18px max(calc((100vw - 1040px) / 2), 24px); background: #143c32; color: white; }
      header a { color: white; text-decoration: none; font-weight: 700; }
      header form { display: flex; align-items: center; gap: 10px; }
      header label { font-size: 13px; }
      main { max-width: 1040px; margin: 38px auto; padding: 0 24px 50px; }
      h1 { font-size: 32px; margin: 0 0 8px; letter-spacing: -0.04em; }
      h2 { margin-top: 30px; }
      p.muted, .muted { color: #63716c; }
      .panel, .candidate-card { background: white; border: 1px solid #e0e7e2; border-radius: 12px; padding: 20px; margin: 14px 0; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
      .button, button { display: inline-block; border: 0; border-radius: 8px; padding: 10px 14px; background: #176a53; color: white; font: inherit; text-decoration: none; cursor: pointer; }
      .button.secondary { background: #e8f0eb; color: #174638; }
      input, select, textarea { font: inherit; padding: 9px 10px; border: 1px solid #cbd6cf; border-radius: 7px; background: white; }
      label.field { display: block; font-weight: 650; margin: 16px 0 6px; }
      textarea { width: 100%; min-height: 110px; }
      .flash { padding: 12px 16px; border-radius: 8px; background: #e6f2eb; margin-bottom: 18px; }
      .flash.alert { background: #fff0e9; }
      .score { border-top: 1px solid #e7ece8; padding: 14px 0; }
      .score dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .score dt { color: #63716c; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
      .score dd { margin: 4px 0 0; }
      @media (max-width: 640px) { header { align-items: flex-start; gap: 12px; flex-direction: column; } header form { flex-wrap: wrap; } }
    </style>
  </head>
  <body>
    <header>
      <%= link_to "Loxo · Hiring", root_path %>
      <% if current_user %>
        <%= form_with url: select_user_path, method: :post do |form| %>
          <%= form.label :user_name, "Viewing as" %>
          <%= form.select :user_name, User.all.map { |user| ["#{user.name} · #{user.role}", user.name] }, { selected: current_user.name }, onchange: "this.form.requestSubmit()" %>
        <% end %>
      <% end %>
    </header>
    <main>
      <% if notice.present? %><div class="flash"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
